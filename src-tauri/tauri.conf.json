{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stockroom",
  "version": "0.1.0",
  "identifier": "com.stockroom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Stockroom", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": [] }
}
