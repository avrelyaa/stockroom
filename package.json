{
  "name": "stockroom-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-desktop.ps1",
    "server:start": "node server/start.mjs",
    "owner:create": "node server/create-owner.mjs",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-svelte": "^0.468.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/cli": "^2.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
